# Directus — adresa pro server a statický token administrátora (nikdy ne NEXT_PUBLIC_)
DIRECTUS_URL=http://localhost:8058
DIRECTUS_ADMIN_TOKEN=your-admin-token

# ID role Student v Directusu (Settings → User Roles → Student)
DIRECTUS_STUDENT_ROLE_ID=your-student-role-id

# Známé při buildu (Docker build args)
NEXT_PUBLIC_DIRECTUS_URL=http://localhost:8058
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Správa: e-maily s přístupem na /dasa (oddělené čárkou) a kontakt u obnovy hesla
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.com
